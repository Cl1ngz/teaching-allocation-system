# Local run (backend started directly on your machine, PostgreSQL installed locally).
# Copy this file to "backend/.env" and set real values.
# ".env" is ignored by git - never commit real credentials.
#
# Variable names match compose.yaml. NOTE: the root .env.example (Docker Compose)
# uses host "db" in the URL, which exists only inside the Docker network.
# Locally use "localhost".

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tas_db
SPRING_DATASOURCE_USERNAME=tas_user
SPRING_DATASOURCE_PASSWORD=tas_password
